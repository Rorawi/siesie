# Siesie environment variables — copy to .env and fill in real values
# Never commit .env; it is gitignored. This file (.env.example) is safe to commit.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL from: Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only service-role key from: Supabase → Project Settings → API
# Keep this secret — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin dashboard ──────────────────────────────────────────────────────────
# Protects /admin and /api/admin in production — use a strong password
ADMIN_PASSWORD=

# ── Contact numbers (optional — enables live WhatsApp/call links) ────────────
# WhatsApp number in international format without + or spaces, e.g. 233XXXXXXXXX
NEXT_PUBLIC_SIESIE_WHATSAPP_NUMBER=

# Receptionist/dispatcher number shown after a request waits 10+ minutes
NEXT_PUBLIC_SIESIE_RECEPTION_PHONE=

# ── Email (SMTP) — optional but recommended for production ──────────────────
# Without SMTP, requests/waitlist entries are saved but no emails are sent.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username-or-email
SMTP_PASS=your-smtp-password
# Sender address shown in From: header (defaults to SMTP_USER if not set)
SMTP_FROM=Siesie <noreply@yourdomain.com>
# Inbox that receives new request and waitlist notifications
OWNER_EMAIL=owner@yourdomain.com

# ── Optional overrides ───────────────────────────────────────────────────────
# Override Nominatim geocoding provider (defaults to https://nominatim.openstreetmap.org)
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
